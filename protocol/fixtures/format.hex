# FORMAT: 48000 Hz, 2 channels, 2 bytes per sample, 96-frame capture blocks
53 54 01 02                    # "ST", version 1, type FORMAT
80 bb 00 00                    # sample rate 48000
02 00                          # channels 2
02 00                          # bytes per sample 2
60 00 00 00                    # block frames 96
